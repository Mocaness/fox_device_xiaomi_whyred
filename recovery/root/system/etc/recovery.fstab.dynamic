system                                                   /system              ext4    rw,barrier=1,discard                                                                            rw,wait,logical
system_ext                                               /system_ext          ext4    rw,barrier=1,discard                                                                            rw,wait,logical
product                                                  /product             ext4    rw,barrier=1,discard                                                                            rw,wait,logical
vendor                                                   /vendor              ext4    rw,barrier=1,discard                                                                            rw,wait,logical
odm                                                      /odm                 ext4    rw,barrier=1,discard                                                                            rw,wait,logical
/dev/block/bootdevice/by-name/logdump                    /metadata            ext4    nosuid,nodev,noatime,discard                                                                    wait,check,formattable
/dev/block/bootdevice/by-name/userdata                   /data                f2fs    nosuid,nodev,fsync_mode=nobarrier,discard,noatime,lazytime                                      wait,check,quota,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+emmc_optimized,keydirectory=/metadata/vold/metadata_encryption
