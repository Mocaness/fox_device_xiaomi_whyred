# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# NOTE: /system and /vendor partitions are now early-mounted and the fstab entry is specified in device tree (duplicated below for recovery image purposes only):
#       /proc/device-tree/firmware/android/fstab/system 
#       /proc/device-tree/firmware/android/fstab/vendor

#TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.

# Non-A/B fstab.qcom variant
#<src>                                                   <mnt_point>          <type>  <mnt_flags and options>                                                                         <fs_mgr_flags>
system                                                   /system              ext4    rw,barrier=1,discard                                                                            rw,wait,logical
system_ext                                               /system_ext          ext4    rw,barrier=1,discard                                                                            rw,wait,logical
product                                                  /product             ext4    rw,barrier=1,discard                                                                            rw,wait,logical
vendor                                                   /vendor              ext4    rw,barrier=1,discard                                                                            rw,wait,logical
odm                                                      /odm                 ext4    rw,barrier=1,discard                                                                            rw,wait,logical
/dev/block/by-name/logdump                               /metadata            ext4    noatime,nosuid,nodev,discard                                                                    wait,check,formattable,first_stage_mount
/dev/block/bootdevice/by-name/cache                      /cache               f2fs    nosuid,nodev,noatime,background_gc=on,noatime                                                   defaults
/dev/block/bootdevice/by-name/cache                      /cache               ext4    nosuid,nodev,noatime,barrier=1                                                                  defaults
/dev/block/bootdevice/by-name/userdata                   /data                f2fs    nosuid,nodev,noatime,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier                wait,check,formattable,quota,reservedsize=128M,readahead_size_kb=12,fileencryption=aes-256-xts:aes-256-cts:v2+emmc_optimized
/dev/block/bootdevice/by-name/userdata                   /data                ext4    nosuid,nodev,noatime,barrier=1,noauto_da_alloc,errors=panic                                     wait,latemount,check,fileencryption=ice
/dev/block/bootdevice/by-name/misc                       /misc                emmc    defaults                                                                                        defaults
